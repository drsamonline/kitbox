{
  "_note": "Inputs and the substring the output must contain. Every expected value here is checkable by hand — that is the point of a fixture. Add a line when a calculator's arithmetic is verified, never to make a failing test pass.",
  "tools": {
    "calc/percentchange": {
      "inputs": {
        "pcA": "100",
        "pcB": "125"
      },
      "output": "+25.00%",
      "expects": "100 → 125 is +25.00%"
    },
    "calc/percentage": {
      "inputs": {
        "pX": "25",
        "pY": "200"
      },
      "output": "12.5%",
      "expects": "25 is 12.5% of 200"
    },
    "calc/statistics": {
      "inputs": {
        "stIn": "1, 2, 3, 4"
      },
      "output": "2.5",
      "expects": "mean of 1–4 is 2.5"
    },
    "calc/sigfig": {
      "inputs": {
        "sfIn": "0.004560",
        "sfN": "3"
      },
      "output": "0.00456",
      "expects": "0.004560 to 3 s.f. is 0.00456",
      "click": "#sfGo"
    },
    "calc/pricing": {
      "inputs": {
        "prCost": "100",
        "prPrice": "150",
        "prFixed": "50000"
      },
      "output": "50.0%",
      "expects": "100 → 150 is a 50% markup"
    },
    "finance/gstsplit": {
      "inputs": {
        "gsAmt": "10000",
        "gsRate": "18"
      },
      "output": "1800.00",
      "expects": "18% of ₹10,000 is ₹1,800"
    },
    "finance/sip": {
      "inputs": {
        "spAmt": "10000",
        "spRate": "12",
        "spYears": "15"
      },
      "output": "50,45,760",
      "expects": "₹10k/mo at 12% for 15y is ₹50,45,760"
    },
    "health/bmi": {
      "inputs": {
        "bmiW": "70",
        "bmiH": "170"
      },
      "output": "24.2",
      "expects": "70 kg at 170 cm is BMI 24.2"
    },
    "science/idealgas": {
      "inputs": {
        "igP": "101.325",
        "igV": "22.4",
        "igT": "0"
      },
      "output": "0.999",
      "expects": "22.4 L at STP is one mole"
    },
    "science/projectile": {
      "inputs": {
        "pjV": "20",
        "pjA": "45",
        "pjH": "0"
      },
      "output": "40.77",
      "expects": "20 m/s at 45° ranges 40.77 m"
    },
    "science/molarity": {
      "inputs": {
        "moC1": "1",
        "moV1": "10",
        "moV2": "100"
      },
      "output": "0.10000 M",
      "expects": "1 M diluted 10→100 mL is 0.1 M"
    },
    "dev/subnet": {
      "inputs": {
        "snCidr": "192.168.1.0/24"
      },
      "output": "255.255.255.0",
      "expects": "a /24 masks to 255.255.255.0",
      "click": "#snGo"
    },
    "dev/md5": {
      "inputs": {
        "md5In": "abc"
      },
      "output": "900150983cd24fb0d6963f7d28e17f72",
      "expects": "MD5('abc') is the published vector"
    },
    "colors/contrast": {
      "inputs": {
        "ctFg": "#000000",
        "ctBg": "#ffffff"
      },
      "output": "21.00",
      "expects": "black on white is 21:1"
    },
    "audio/hznote": {
      "inputs": {
        "hnHz": "440"
      },
      "output": "A4",
      "expects": "440 Hz is A4"
    }
  }
}
