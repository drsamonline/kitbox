{
  "name": "kitbox",
  "version": "2.11.0",
  "private": true,
  "description": "Kitbox \u2014 a single-file offline toolbox. 465 tools, no dependencies, no network.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Dr Sohil Momin",
  "scripts": {
    "test": "node test/smoke.js",
    "a11y": "node test/axe.js",
    "fuzz": "node test/fuzz.js",
    "interact": "node test/interact.js",
    "deep": "node test/deep.js",
    "links": "node test/links.js",
    "min": "node tools/minify.js",
    "dist": "python3 tools/dist.py",
    "minified": "node tools/minify.js && node test/minified.js",
    "badges": "node tools/check-badges.js",
    "shots": "python3 tools/shots.py",
    "tools": "node tools/gen-all-tools.js",
    "codes": "node tools/gen-codes.js --check",
    "docs": "python3 tools/build-docs.py",
    "landing": "python3 tools/build-landing.py",
    "manifest": "python3 tools/check-manifest.py",
    "check": "npm test && npm run a11y && npm run fuzz && npm run interact && npm run deep && npm run links && npm run lib && node test/lib.js && npm run lint && npm run types && npm run codes && npm run badges && npm run tools && npm run docs && npm run dist",
    "build": "python3 tools/build.py",
    "lib": "node tools/build-lib.js",
    "lint": "python3 tools/build.py && eslint dist/app.js",
    "types": "node tools/build-lib.js && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  }
}
